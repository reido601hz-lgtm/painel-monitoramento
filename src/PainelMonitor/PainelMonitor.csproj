<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>PainelMonitor</AssemblyName>
    <RootNamespace>PainelMonitor</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <NoWarn>$(NoWarn);CA1416;CA2007</NoWarn>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- GC de estacao: o Web SDK liga o Server GC, que cria um heap por nucleo (20 aqui) e deixava o
         processo em ~300 MB para um coletor que le sensores a 1 Hz. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
  </ItemGroup>

</Project>
